# Symphony Environment Configuration
# Copy this file to .env and fill in your actual values

# Linear API Integration
LINEAR_API_TOKEN=your_linear_api_token_here

# GitHub Integration (for future tool provisioning)
GITHUB_TOKEN=your_github_token_here

# HubSpot Integration (for future tool provisioning)
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Slack Integration (for future tool provisioning)
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Stripe Integration (for future tool provisioning)
STRIPE_API_KEY=your_stripe_api_key_here

# QuickBooks Integration (for future tool provisioning)
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret_here

# Notion Integration (for future tool provisioning)
NOTION_API_TOKEN=your_notion_api_token_here

# Zoom Integration (for future tool provisioning)
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

# Development Settings
SYMPHONY_ENV=development
LOG_LEVEL=INFO
DEBUG=false