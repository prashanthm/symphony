#!/bin/bash

#####################################################################
# Symphony Universal CLI - The Command Center for Autonomous Enterprise
#####################################################################
#
# This is the single interface to the entire Symphony monorepo.
# Use this script for ALL operations as described in CLAUDE.md.
#
# Usage: ./tools/symphony [command] [subcommand] [options]
#
#####################################################################

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Symphony root directory
SYMPHONY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SYMPHONY_ROOT"

# Ensure UV is available
if ! command -v uv &> /dev/null; then
    echo -e "${RED}Error: UV package manager not found${NC}"
    echo "Install UV: curl -LsSf https://astral.sh/uv/install.sh | sh"
    exit 1
fi

# Ensure virtual environment is set up
if [[ ! -d ".venv" ]]; then
    echo -e "${YELLOW}Setting up virtual environment...${NC}"
    export PATH="$HOME/.local/bin:$PATH"
    uv sync --all-packages
fi

# Activate virtual environment
export PATH="$SYMPHONY_ROOT/.venv/bin:$PATH"

#####################################################################
# Helper Functions
#####################################################################

show_header() {
    echo -e "${PURPLE}🎼 Symphony Universal CLI${NC}"
    echo -e "${PURPLE}═══════════════════════════${NC}"
    echo
}

show_help() {
    show_header
    cat << 'EOF'
The single command interface to the entire Symphony monorepo.

USAGE:
    ./tools/symphony <COMMAND> [SUBCOMMAND] [OPTIONS]

COMMANDS:
    status              Show overall monorepo status
    agent               Agent management and coordination
    customer            Customer configuration management
    integration         Integration orchestration management
    platform            Platform operations (build, test, deploy)
    org                 Organization management
    docs                Documentation operations  
    business            Business operations
    dev                 Development operations
    build               Build system operations
    test                Testing operations
    monitor             Monitoring and health checks

EXAMPLES:
    ./tools/symphony status
    ./tools/symphony agent deploy --package enterprise
    ./tools/symphony customer create acme-corp enterprise healthcare
    ./tools/symphony integration init --integration linear
    ./tools/symphony platform build
    ./tools/symphony org create acme-corp enterprise
    ./tools/symphony docs build external
    ./tools/symphony dev validate

For more help on a specific command:
    ./tools/symphony <command> --help

EOF
}

show_status() {
    show_header
    echo -e "${CYAN}📊 Symphony Monorepo Status${NC}"
    echo

    # Python and UV versions
    echo -e "${BLUE}Environment:${NC}"
    python3 --version 2>/dev/null || echo "  Python: Not available"
    uv --version 2>/dev/null || echo "  UV: Not available"
    echo

    # Virtual environment status
    echo -e "${BLUE}Virtual Environment:${NC}"
    if [[ -d ".venv" ]]; then
        echo -e "  ${GREEN}✓${NC} .venv exists"
        if [[ "$VIRTUAL_ENV" == *".venv" ]] || [[ -n "$UV_VIRTUAL_ENV" ]]; then
            echo -e "  ${GREEN}✓${NC} Virtual environment active"
        else
            echo -e "  ${YELLOW}⚠${NC} Virtual environment not active"
        fi
    else
        echo -e "  ${RED}✗${NC} .venv not found"
    fi
    echo

    # Workspace packages
    echo -e "${BLUE}Workspace Packages:${NC}"
    for pkg in libs/symphony-core libs/symphony-integrations libs/symphony-templates apps/symphony-cli; do
        if [[ -d "$pkg" ]]; then
            echo -e "  ${GREEN}✓${NC} $pkg"
        else
            echo -e "  ${RED}✗${NC} $pkg"
        fi
    done
    echo

    # Directory structure
    echo -e "${BLUE}Directory Structure:${NC}"
    for dir in workspace build core organizations releases tools docs business ops data; do
        if [[ -d "$dir" ]]; then
            echo -e "  ${GREEN}✓${NC} $dir/"
        else
            echo -e "  ${YELLOW}○${NC} $dir/ (planned)"
        fi
    done
    echo

    # Configuration files
    echo -e "${BLUE}Configuration:${NC}"
    for file in pyproject.toml CLAUDE.md .env; do
        if [[ -f "$file" ]]; then
            echo -e "  ${GREEN}✓${NC} $file"
        else
            echo -e "  ${RED}✗${NC} $file"
        fi
    done
}

#####################################################################
# Command Implementations
#####################################################################

cmd_platform() {
    case "${2:-}" in
        "build")
            echo -e "${CYAN}🔨 Building Symphony Platform${NC}"
            export PATH="$HOME/.local/bin:$PATH"
            uv sync --all-packages
            echo -e "${GREEN}✓ Platform build complete${NC}"
            ;;
        "test")
            echo -e "${CYAN}🧪 Testing Symphony Platform${NC}"
            if command -v pytest &> /dev/null; then
                pytest tests/ -v
            else
                echo -e "${YELLOW}Installing pytest...${NC}"
                uv add --group dev pytest pytest-asyncio
                .venv/bin/pytest tests/ -v
            fi
            ;;
        "deploy")
            echo -e "${CYAN}🚀 Deploying Symphony Platform${NC}"
            echo "Deploy functionality coming soon..."
            ;;
        *)
            echo "Usage: ./tools/symphony platform {build|test|deploy}"
            ;;
    esac
}

cmd_org() {
    case "${2:-}" in
        "create")
            local name="${3:-}"
            local type="${4:-startup}"
            if [[ -z "$name" ]]; then
                echo "Usage: ./tools/symphony org create <name> [startup|smb|enterprise|global]"
                exit 1
            fi
            echo -e "${CYAN}🏢 Creating Organization: $name ($type)${NC}"
            mkdir -p "organizations/customers/$name"
            echo "# $name Organization Configuration" > "organizations/customers/$name/README.md"
            echo "Organization type: $type" >> "organizations/customers/$name/README.md"
            echo -e "${GREEN}✓ Organization '$name' created${NC}"
            ;;
        "list")
            echo -e "${CYAN}📋 Organizations${NC}"
            if [[ -d "organizations/customers" ]]; then
                ls -la organizations/customers/ || echo "No organizations found"
            else
                echo "No organizations directory found"
            fi
            ;;
        "deploy")
            echo -e "${CYAN}🚀 Deploying Organization${NC}"
            echo "Deploy functionality coming soon..."
            ;;
        *)
            echo "Usage: ./tools/symphony org {create|list|deploy}"
            ;;
    esac
}

cmd_docs() {
    case "${2:-}" in
        "build")
            local target="${3:-all}"
            echo -e "${CYAN}📚 Building Documentation: $target${NC}"
            if command -v mkdocs &> /dev/null; then
                mkdocs build
            else
                echo "Documentation build functionality coming soon..."
            fi
            ;;
        "serve")
            echo -e "${CYAN}🌐 Serving Documentation${NC}"
            if command -v mkdocs &> /dev/null; then
                mkdocs serve
            else
                echo "Documentation serve functionality coming soon..."
            fi
            ;;
        "publish")
            local target="${3:-external}"
            echo -e "${CYAN}📤 Publishing Documentation: $target${NC}"
            echo "Documentation publishing coming soon..."
            ;;
        *)
            echo "Usage: ./tools/symphony docs {build|serve|publish}"
            ;;
    esac
}

cmd_business() {
    case "${2:-}" in
        "customers")
            echo -e "${CYAN}👥 Customer Management${NC}"
            cmd_org list
            ;;
        "analytics")
            echo -e "${CYAN}📊 Business Analytics${NC}"
            echo "Analytics functionality coming soon..."
            ;;
        "sales")
            echo -e "${CYAN}💰 Sales Operations${NC}"
            echo "Sales operations coming soon..."
            ;;
        *)
            echo "Usage: ./tools/symphony business {customers|analytics|sales}"
            ;;
    esac
}

cmd_dev() {
    case "${2:-}" in
        "workspace")
            echo -e "${CYAN}🚀 Development Workspace${NC}"
            export PATH="$HOME/.local/bin:$PATH"
            uv sync --all-packages
            echo -e "${GREEN}✓ Workspace ready${NC}"
            ;;
        "validate")
            echo -e "${CYAN}✅ Validating Monorepo${NC}"
            echo "Running validation checks..."
            
            # Check pyproject.toml files
            local valid=true
            for pkg in libs/symphony-core libs/symphony-integrations libs/symphony-templates apps/symphony-cli; do
                if [[ ! -f "$pkg/pyproject.toml" ]]; then
                    echo -e "${RED}✗ Missing: $pkg/pyproject.toml${NC}"
                    valid=false
                else
                    echo -e "${GREEN}✓ $pkg/pyproject.toml${NC}"
                fi
            done
            
            if $valid; then
                echo -e "${GREEN}✓ Monorepo validation passed${NC}"
            else
                echo -e "${RED}✗ Monorepo validation failed${NC}"
                exit 1
            fi
            ;;
        "monitor")
            echo -e "${CYAN}📈 Development Monitoring${NC}"
            show_status
            ;;
        *)
            echo "Usage: ./tools/symphony dev {workspace|validate|monitor}"
            ;;
    esac
}

cmd_build() {
    echo -e "${CYAN}🔨 Build System${NC}"
    export PATH="$HOME/.local/bin:$PATH"
    uv sync --all-packages
    echo -e "${GREEN}✓ Build complete${NC}"
}

cmd_test() {
    echo -e "${CYAN}🧪 Running Tests${NC}"
    if [[ -d "tests" ]]; then
        export PATH="$HOME/.local/bin:$PATH"
        if [[ -f ".venv/bin/pytest" ]]; then
            .venv/bin/pytest tests/ -v
        else
            echo "Installing test dependencies..."
            uv add --group dev pytest pytest-asyncio
            .venv/bin/pytest tests/ -v
        fi
    else
        echo "No tests directory found"
    fi
}

cmd_agent() {
    echo -e "${CYAN}🤖 Agent Management System${NC}"
    
    # Ensure Python CLI is available
    if [[ ! -f ".venv/bin/python" ]]; then
        echo -e "${YELLOW}Setting up Python environment...${NC}"
        export PATH="$HOME/.local/bin:$PATH"
        uv sync --all-packages
    fi
    
    # Run Python CLI with agent command
    export PATH="$SYMPHONY_ROOT/.venv/bin:$PATH"
    export PYTHONPATH="$SYMPHONY_ROOT/libs/symphony-core/src:$SYMPHONY_ROOT/libs/symphony-integrations/src:$SYMPHONY_ROOT/apps/symphony-cli/src:$PYTHONPATH"
    
    # Pass all arguments to Python CLI
    python -m symphony_cli.main agent "${@:2}"
}

cmd_integration() {
    echo -e "${CYAN}🔗 Integration Orchestration Management${NC}"
    
    # Ensure Python CLI is available
    if [[ ! -f ".venv/bin/python" ]]; then
        echo -e "${YELLOW}Setting up Python environment...${NC}"
        export PATH="$HOME/.local/bin:$PATH"
        uv sync --all-packages
    fi
    
    # Run Python CLI with integration command
    export PATH="$SYMPHONY_ROOT/.venv/bin:$PATH"
    export PYTHONPATH="$SYMPHONY_ROOT/libs/symphony-core/src:$SYMPHONY_ROOT/libs/symphony-integrations/src:$SYMPHONY_ROOT/apps/symphony-cli/src:$PYTHONPATH"
    
    # Pass all arguments to Python CLI
    python -m symphony_cli.main integration "${@:2}"
}

cmd_customer() {
    echo -e "${CYAN}👤 Customer Configuration Management${NC}"
    
    # Ensure Python CLI is available
    if [[ ! -f ".venv/bin/python" ]]; then
        echo -e "${YELLOW}Setting up Python environment...${NC}"
        export PATH="$HOME/.local/bin:$PATH"
        uv sync --all-packages
    fi
    
    # Run Python CLI with customer command
    export PATH="$SYMPHONY_ROOT/.venv/bin:$PATH"
    export PYTHONPATH="$SYMPHONY_ROOT/libs/symphony-core/src:$SYMPHONY_ROOT/libs/symphony-integrations/src:$SYMPHONY_ROOT/apps/symphony-cli/src:$PYTHONPATH"
    
    case "${2:-}" in
        "create")
            local name="${3:-}"
            local package="${4:-startup}"
            local industry="${5:-general}"
            if [[ -z "$name" ]]; then
                echo "Usage: ./tools/symphony customer create <name> [startup|smb|enterprise|global] [industry]"
                exit 1
            fi
            echo -e "${CYAN}👤 Creating Customer: $name ($package, $industry)${NC}"
            python -c "
import sys
sys.path.insert(0, '$SYMPHONY_ROOT/libs/symphony-core/src')
from symphony_core.config.customer_manager import CustomerConfigManager

try:
    manager = CustomerConfigManager()
    
    # Generate customer configuration
    config = manager.generate_customer_config(
        organization_name='$name',
        customer_id='$(echo $name | tr '[:upper:]' '[:lower:]' | tr ' ' '-')',
        industry='$industry',
        package_type='$package'
    )
    
    # Save the configuration
    config_path = manager.save_customer_config(config)
    
    print(f'✅ Customer $name created successfully')
    print(f'📁 Configuration stored at: {config_path}')
    
except Exception as e:
    print(f'❌ Failed to create customer: {e}')
    sys.exit(1)
"
            ;;
        "list")
            echo -e "${CYAN}📋 Customer Configurations${NC}"
            python -c "
import sys
sys.path.insert(0, '$SYMPHONY_ROOT/libs/symphony-core/src')
from symphony_core.config.customer_manager import CustomerConfigManager

manager = CustomerConfigManager()
customers = manager.list_customers()
if customers:
    for customer in customers:
        print(f'  • {customer}')
else:
    print('  No customers configured')
"
            ;;
        "status")
            local name="${3:-}"
            if [[ -z "$name" ]]; then
                echo "Usage: ./tools/symphony customer status <name>"
                exit 1
            fi
            echo -e "${CYAN}📊 Customer Status: $name${NC}"
            python -c "
import sys
sys.path.insert(0, '$SYMPHONY_ROOT/libs/symphony-core/src')
from symphony_core.config.customer_manager import CustomerConfigManager

try:
    manager = CustomerConfigManager()
    customer_id = '$(echo $name | tr '[:upper:]' '[:lower:]' | tr ' ' '-')'
    
    config = manager.load_customer_config(customer_id)
    if config:
        # Handle both CustomerConfig object and dict formats
        if hasattr(config, 'customer_profile'):
            profile = config.customer_profile
            print(f'  Organization: {profile.organization_name}')
            print(f'  Customer ID: {profile.customer_id}')
            print(f'  Industry: {profile.industry}')
            print(f'  Team Size: {profile.team_size}')
            print(f'  Timeline: {profile.implementation_timeline}')
            print(f'  Primary Contact: {profile.primary_contact.get(\"name\", \"N/A\")}')
        else:
            # Handle dict format
            profile = config.get('customer_profile', {})
            print(f'  Organization: {profile.get(\"organization_name\", \"N/A\")}')
            print(f'  Customer ID: {profile.get(\"customer_id\", \"N/A\")}')
            print(f'  Industry: {profile.get(\"industry\", \"N/A\")}')
            print(f'  Team Size: {profile.get(\"team_size\", \"N/A\")}')
            print(f'  Timeline: {profile.get(\"implementation_timeline\", \"N/A\")}')
            primary_contact = profile.get('primary_contact', {})
            print(f'  Primary Contact: {primary_contact.get(\"name\", \"N/A\")}')
    else:
        print(f'❌ Customer $name not found')
        sys.exit(1)
        
except Exception as e:
    print(f'❌ Error retrieving customer status: {e}')
    sys.exit(1)
"
            ;;
        *)
            echo "Usage: ./tools/symphony customer {create|list|status}"
            ;;
    esac
}

cmd_monitor() {
    case "${2:-}" in
        "init")
            echo -e "${CYAN}📈 Initializing Monitoring${NC}"
            mkdir -p logs
            echo "Monitoring initialized"
            ;;
        "check")
            echo -e "${CYAN}🔍 Health Check${NC}"
            show_status
            ;;
        "monitor")
            echo -e "${CYAN}📊 Live Monitoring${NC}"
            echo "Live monitoring functionality coming soon..."
            ;;
        *)
            echo "Usage: ./tools/symphony monitor {init|check|monitor}"
            ;;
    esac
}

#####################################################################
# Main Command Dispatcher
#####################################################################

case "${1:-}" in
    "status")
        show_status
        ;;
    "agent")
        cmd_agent "$@"
        ;;
    "customer")
        cmd_customer "$@"
        ;;
    "integration")
        cmd_integration "$@"
        ;;
    "platform")
        cmd_platform "$@"
        ;;
    "org")
        cmd_org "$@"
        ;;
    "docs")
        cmd_docs "$@"
        ;;
    "business")
        cmd_business "$@"
        ;;
    "dev")
        cmd_dev "$@"
        ;;
    "build")
        cmd_build "$@"
        ;;
    "test")
        cmd_test "$@"
        ;;
    "monitor")
        cmd_monitor "$@"
        ;;
    "--help"|"-h"|"help"|"")
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: ${1}${NC}"
        echo
        show_help
        exit 1
        ;;
esac